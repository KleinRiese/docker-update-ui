# Passwort für die Weboberfläche (Pflichtfeld – ohne Passwort startet der Container nicht)
WEB_PASSWORD=bitte-aendern

# Zeitzone (betrifft Zeitstempel von Backups und Logs)
TZ=Europe/Berlin

# Port auf dem Docker-Host
UI_PORT=8080

# Optionale Standardwerte (können auch in der Oberfläche geändert werden)
# BACKUP_DIR=/docker/backups
# BROWSE_DIR=/docker
# MAX_ROLLBACKS=3
# CONFIG_DIR=/config
# SESSION_TTL=43200
# COOKIE_SECURE=0
# STOP_TIMEOUT=30

# E-Mail-Benachrichtigungen (SMTP). Das Passwort wird nur hier gesetzt und
# nie in der Oberfläche gespeichert oder angezeigt.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # none, starttls oder ssl
# SMTP_USER=docker-update-ui@example.com
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=ich@example.com       # mehrere Adressen mit Komma trennen
# SMTP_TIMEOUT=10

# Commit, der im Footer der Oberfläche angezeigt wird. Meist schon beim Bauen
# gesetzt (GIT_COMMIT=$(git rev-parse --short HEAD) docker compose build); ein
# Eintrag hier überschreibt den Wert aus dem Image.
# GIT_COMMIT=

# Automatische Update-Prüfung (Zeitpläne werden pro Container gesetzt)
# AUTO_CHECK_CRON=0 4 * * *
# AUTO_CHECK_TICK=30

# Nur nötig, wenn die Oberfläche hinter einem Reverse Proxy läuft und die
# Meldung "Anfrage abgelehnt (CSRF-Schutz)" erscheint: öffentliche Adresse(n)
# kommasepariert eintragen (Schema optional).
# ALLOWED_ORIGINS=https://docker.example.com
# CSRF-Schutz nur bewusst abschalten, wenn der Zugriff anderweitig abgesichert ist:
# CSRF_PROTECTION=0
# DOCKER_TIMEOUT=600
