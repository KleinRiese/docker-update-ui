# Passwort für die Weboberfläche (Pflichtfeld – ohne Passwort startet der Container nicht)
WEB_PASSWORD=bitte-aendern

# Zeitzone (betrifft Zeitstempel von Backups und Logs)
TZ=Europe/Berlin

# Port auf dem Docker-Host
UI_PORT=8080

# Optionale Standardwerte (können auch in der Oberfläche geändert werden)
# BACKUP_DIR=/docker/backups
# BROWSE_DIR=/docker
# MAX_ROLLBACKS=3
# CONFIG_DIR=/config
# SESSION_TTL=43200
# COOKIE_SECURE=0
# STOP_TIMEOUT=30

# Automatische Update-Prüfung (Zeitpläne werden pro Container gesetzt)
# NOTIFY_URL=https://example.com/webhook
# AUTO_CHECK_CRON=0 4 * * *
# AUTO_CHECK_TICK=30
# NOTIFY_TIMEOUT=10

# Nur nötig, wenn die Oberfläche hinter einem Reverse Proxy läuft und die
# Meldung "Anfrage abgelehnt (CSRF-Schutz)" erscheint: öffentliche Adresse(n)
# kommasepariert eintragen (Schema optional).
# ALLOWED_ORIGINS=https://docker.example.com
# CSRF-Schutz nur bewusst abschalten, wenn der Zugriff anderweitig abgesichert ist:
# CSRF_PROTECTION=0
# DOCKER_TIMEOUT=600
